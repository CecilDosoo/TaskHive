  "description": "TaskHive Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "prisma generate && node dist/server.js",
    "start:migrate": "node scripts/start-with-migrations.js",
    "prisma:generate": "prisma generate",
    "prisma:generate:safe": "prisma generate --schema=./prisma/schema.prisma || echo 'Prisma generate skipped - DATABASE_URL not available'",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "test:db": "tsx test-db-connection.ts"
  },
